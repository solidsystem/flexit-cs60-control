{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "nRF: Build",
            "type": "shell",
            "command": "/opt/nordic/ncs/toolchains/0c0f19d91c/bin/west",
            "args": [
                "build",
                "-b",
                "xiao_ble/nrf52840",
                "--sysbuild",
                "--build-dir",
                "${workspaceFolder}/build"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ZEPHYR_BASE": "/opt/nordic/ncs/v3.3.0/zephyr",
                    "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
                    "ZEPHYR_SDK_INSTALL_DIR": "/opt/nordic/ncs/toolchains/0c0f19d91c/opt/zephyr-sdk",
                    "NRFUTIL_HOME": "/opt/nordic/ncs/toolchains/0c0f19d91c/nrfutil/home",
                    "PATH": "/opt/nordic/ncs/toolchains/0c0f19d91c/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/usr/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/opt/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/nrfutil/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/opt/zephyr-sdk/arm-zephyr-eabi/bin:${env:PATH}"
                }
            },
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "nRF: Build (Pristine)",
            "type": "shell",
            "command": "/opt/nordic/ncs/toolchains/0c0f19d91c/bin/west",
            "args": [
                "build",
                "-b",
                "xiao_ble/nrf52840",
                "--sysbuild",
                "--pristine",
                "--build-dir",
                "${workspaceFolder}/build"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ZEPHYR_BASE": "/opt/nordic/ncs/v3.3.0/zephyr",
                    "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
                    "ZEPHYR_SDK_INSTALL_DIR": "/opt/nordic/ncs/toolchains/0c0f19d91c/opt/zephyr-sdk",
                    "NRFUTIL_HOME": "/opt/nordic/ncs/toolchains/0c0f19d91c/nrfutil/home",
                    "PATH": "/opt/nordic/ncs/toolchains/0c0f19d91c/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/usr/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/opt/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/nrfutil/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/opt/zephyr-sdk/arm-zephyr-eabi/bin:${env:PATH}"
                }
            },
            "group": "build",
            "problemMatcher": [
                "$gcc"
            ]
        },
        {
            "label": "nRF: Flash",
            "type": "shell",
            "command": "/opt/nordic/ncs/toolchains/0c0f19d91c/bin/west",
            "args": [
                "flash",
                "--build-dir",
                "${workspaceFolder}/build"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ZEPHYR_BASE": "/opt/nordic/ncs/v3.3.0/zephyr",
                    "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
                    "ZEPHYR_SDK_INSTALL_DIR": "/opt/nordic/ncs/toolchains/0c0f19d91c/opt/zephyr-sdk",
                    "NRFUTIL_HOME": "/opt/nordic/ncs/toolchains/0c0f19d91c/nrfutil/home",
                    "PATH": "/opt/nordic/ncs/toolchains/0c0f19d91c/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/usr/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/opt/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/nrfutil/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/opt/zephyr-sdk/arm-zephyr-eabi/bin:${env:PATH}"
                }
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "nRF: Build & Flash",
            "dependsOrder": "sequence",
            "dependsOn": [
                "nRF: Build",
                "nRF: Flash"
            ],
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "nRF: Menuconfig",
            "type": "shell",
            "command": "/opt/nordic/ncs/toolchains/0c0f19d91c/bin/west",
            "args": [
                "build",
                "--build-dir",
                "${workspaceFolder}/build",
