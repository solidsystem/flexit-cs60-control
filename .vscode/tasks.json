            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ZEPHYR_BASE": "/opt/nordic/ncs/v3.3.0/zephyr",
                    "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
                    "ZEPHYR_SDK_INSTALL_DIR": "/opt/nordic/ncs/toolchains/0c0f19d91c/opt/zephyr-sdk",
                    "NRFUTIL_HOME": "/opt/nordic/ncs/toolchains/0c0f19d91c/nrfutil/home",
                    "PATH": "/opt/nordic/ncs/toolchains/0c0f19d91c/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/usr/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/opt/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/nrfutil/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/opt/zephyr-sdk/arm-zephyr-eabi/bin:${env:PATH}"
                }
            },
            "group": "none",
            "problemMatcher": []
        },
        {
            "label": "nRF: Flash (SWD, app only)",
            "type": "shell",
            "command": "/opt/nordic/ncs/toolchains/0c0f19d91c/bin/west",
            "args": [
                "flash",
                "--runner",
                "jlink",
                "--dev-id",
                "1050279550",
                "--domain",
                "flexitMC3",
                "--build-dir",
                "${workspaceFolder}/build"
            ],
            "options": {
                "cwd": "${workspaceFolder}",
                "env": {
                    "ZEPHYR_BASE": "/opt/nordic/ncs/v3.3.0/zephyr",
                    "ZEPHYR_TOOLCHAIN_VARIANT": "zephyr",
                    "ZEPHYR_SDK_INSTALL_DIR": "/opt/nordic/ncs/toolchains/0c0f19d91c/opt/zephyr-sdk",
                    "NRFUTIL_HOME": "/opt/nordic/ncs/toolchains/0c0f19d91c/nrfutil/home",
                    "PATH": "/opt/nordic/ncs/toolchains/0c0f19d91c/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/usr/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/opt/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/nrfutil/bin:/opt/nordic/ncs/toolchains/0c0f19d91c/opt/zephyr-sdk/arm-zephyr-eabi/bin:${env:PATH}"
                }
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "nRF: USB DFU Flash",
            "type": "shell",
            "command": "${workspaceFolder}/tools/usb_dfu_flash.sh",
            "args": [
                "build"
            ],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
        },
        {
            "label": "nRF: Build & USB DFU Flash",
            "dependsOrder": "sequence",
            "dependsOn": [
                "nRF: Build",
                "nRF: USB DFU Flash"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": []
        },
        {
            "label": "nRF: USB DFU Confirm",
            "type": "shell",
            "command": "${workspaceFolder}/tools/usb_dfu_confirm.sh",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "group": "test",
            "problemMatcher": []
